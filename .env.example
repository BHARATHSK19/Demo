# OJIX Server Configuration
PORT=3000
NODE_ENV=production

# Security & CORS
ALLOWED_ORIGINS=https://ojix.in,https://www.ojix.in,http://localhost:3000

# DPDP Act 2023 Statutory Salt for IP anonymization hashing
DPDP_SALT=change-to-a-secure-random-secret-in-production-64bytes

# Retention Window (in days, default 180)
DATA_RETENTION_DAYS=180

# React Bits Pro Component Registry (Optional: required for shadcn CLI downloads)
REACTBITS_LICENSE_KEY=your-reactbits-license-key-here
